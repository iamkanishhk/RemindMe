# Runtime
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
VERSION=0.1.0

# Clerk (backend secret — never expose to clients)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Neon Postgres (pooled for app traffic, direct/unpooled for migrations only)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Upstash Redis (BullMQ + rate-limit counters)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telnyx Voice
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
# Ed25519 public key used to verify webhook signatures (Telnyx portal)
TELNYX_PUBLIC_KEY=

# Abuse control: comma-separated allowed country calling codes (e.g. +1,+44,+60)
# Empty = allow all (dev). Production should always set this.
GEO_ALLOW_PREFIXES=

# Observability (PII scrubbing enabled; never send phone/message)
SENTRY_DSN=

# CORS: comma-separated origins to allow (e.g. http://localhost:5173). Empty = allow all.
CORS_ORIGINS=

# Dodo Payments (subscription billing)
# Both plans must be configured; the plans screen shows exactly these two.
# Recurring monthly product, e.g. pdt_xxx
DODO_PAYMENTS_PRODUCT_ID=
# Recurring annual product, e.g. pdt_xxx
DODO_PAYMENTS_ANUAL_PRODUCT_ID=
DODO_PAYMENTS_API_KEY=
# Used to verify Dodo webhook signatures
DODO_PAYMENTS_WEBHOOK_KEY=
# "test_mode" or "live_mode"
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Where Dodo returns the user after checkout or cancellation
DODO_PAYMENTS_RETURN_URL=http://localhost:5173/subscriptions
# Trial length handed to Dodo at checkout, in days
TRIAL_PERIOD_DAYS=2
