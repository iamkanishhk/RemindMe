generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum RepeatRule {
  NONE
  DAILY
  WEEKLY
}

enum ReminderStatus {
  SCHEDULED
  CALLING
  ANSWERED
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  ON_HOLD
  CANCELLED
  EXPIRED
  FAILED
}

model User {
  id            String         @id @default(cuid())
  clerkUserId   String         @unique
  email         String         @unique
  // First name from Clerk registration; used to personalize the spoken
  // greeting ("Hello Kanishk, ..."). Lazily backfilled from Clerk.
  firstName     String?
  phoneNumbers  PhoneNumber[]
  reminders     Reminder[]
  subscriptions Subscription[]
  // Set when the user finishes the post-signup Maya intro (onboarding step 2).
  onboardingCompletedAt DateTime?
  // Consumed (atomically, at reminder creation) on the user's single free
  // reminder/call. Never refunded, even if the reminder is later deleted.
  freeCallUsed    Boolean        @default(false)
  // Daily reminder creation quota for entitled (paid/trial) accounts. Bucket is
  // the user's local calendar day (YYYY-MM-DD, derived from timezone) the count
  // belongs to. Incremented atomically at creation and never decremented, so
  // deleted reminders still count against it.
  reminderDailyBucket String?
  reminderDailyCount  Int          @default(0)
  // IANA timezone inferred from the user's reminders; drives the local-midnight
  // daily quota reset.
  timezone      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Subscription {
  id                     String             @id @default(cuid())
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  providerCustomerId     String
  providerSubscriptionId String             @unique
  status                 SubscriptionStatus
  productId              String
  amountMinorUnits       Int
  currency               String
  interval               String?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  billingStartedAt       DateTime?
  trialCallsUsed         Int                @default(0)
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId, status])
  @@map("subscriptions")
}

model BillingEvent {
  id          String   @id @default(cuid())
  webhookId   String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@map("billing_events")
}

model PhoneNumber {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  e164       String    @unique
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reminders  Reminder[]

  @@index([userId])
  @@map("phone_numbers")
}

model Reminder {
  id            String         @id @default(cuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  message       String
  timezone      String
  scheduledAt   DateTime
  nextRunAt     DateTime?
  repeatRule    RepeatRule     @default(NONE)
  isEnabled     Boolean        @default(true)
  // True when this reminder is the account's one free reminder/call. Such a
  // reminder bypasses the entitlement gate at fire time but is restricted to a
  // single one-shot call (repeatRule NONE).
  isFreeCall    Boolean        @default(false)
  status        ReminderStatus @default(SCHEDULED)
  lastCallAt    DateTime?
  phoneNumber   PhoneNumber?   @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  phoneNumberId String?
  attempts      CallAttempt[]
  createdAt     DateTime       @default(now())
  // Enhanced, natural-sounding version of `message`, rewritten by the backend
  // AI service for TTS. Null when the AI is unavailable, in which case `message`
  // is spoken verbatim.
  voiceMessage  String?
  updatedAt     DateTime       @updatedAt

  @@index([userId, nextRunAt])
  @@index([status, nextRunAt])
  @@map("reminders")
}

model CallAttempt {
  id             String         @id @default(cuid())
  reminder       Reminder       @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  reminderId     String
  startedAt      DateTime       @default(now())
  endedAt        DateTime?
  providerCallId String?        @unique
  status         ReminderStatus
  detail         String?

  @@index([reminderId])
  @@index([startedAt])
  @@map("call_attempts")
}